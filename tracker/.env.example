# Neon Postgres connection string (required).
# Create a free project at https://neon.tech, then run db/001_init.sql against it.
DATABASE_URL=

# Optional: makes ticket keys link out to JIRA.
NEXT_PUBLIC_JIRA_BASE_URL=

# Optional: turns on a shared-password gate. Leave blank for no login at all.
# When set, visit the site once as https://your-app.vercel.app/?key=<password>
TRACKER_PASSWORD=
